<Project Sdk="Microsoft.NET.Sdk.WindowsDesktop">

  <PropertyGroup>
    <TargetFramework>net472</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <AssemblyName>WeatherPlugin</AssemblyName>
    <RootNamespace>WeatherPlugin</RootNamespace>
    <Nullable>disable</Nullable>
    <LangVersion>7.3</LangVersion>
    <PlatformTarget>AnyCPU</PlatformTarget>
    <!-- SDK auto-generates AssemblyInfo; our manual one would conflict -->
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <OutputPath>C:\Users\levis\Documents\vatSys Files\Profiles\Australia\Plugins\vatSys Weather</OutputPath>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <AppendRuntimeIdentifierToOutputPath>false</AppendRuntimeIdentifierToOutputPath>
    <DebugType>none</DebugType>
    <DebugSymbols>false</DebugSymbols>
  </PropertyGroup>

  <ItemGroup>
    <Reference Include="vatSys">
      <HintPath>C:\Program Files (x86)\vatSys\bin\vatSys.exe</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="System.ComponentModel.Composition" />
    <Reference Include="System.Net.Http" />
  </ItemGroup>

</Project>
